{
  "name": "maschinenplan-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Zero-dependency SQLite-backed booking server with live SSE updates.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning dist/server/server.js",
    "import": "node --disable-warning=ExperimentalWarning dist/server/import.js",
    "backfill": "node --disable-warning=ExperimentalWarning dist/server/backfill.js",
    "dev": "vite",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deadcode": "knip",
    "verify": "npm run format:check && npm run check && npm run lint && npm run deadcode && npm run test:cov"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^2.1.4",
    "eslint": "^9.14.0",
    "knip": "^5.36.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
