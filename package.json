{
  "name": "maschinenplan-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Zero-dependency SQLite-backed booking server with live SSE updates.",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.mjs",
    "import": "node --disable-warning=ExperimentalWarning src/import.mjs",
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "@types/node": "^22.9.0"
  }
}
